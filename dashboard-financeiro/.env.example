# =============================================================================
# PrevisionFinance – Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores
# NUNCA commite o .env.local no repositório
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (Turso / LibSQL) — OBRIGATÓRIO
# Crie sua conta em https://turso.tech e um banco de dados
# -----------------------------------------------------------------------------
TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
TURSO_AUTH_TOKEN="seu-token-de-autenticacao"

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO (Clerk) — OBRIGATÓRIO
# Crie sua conta em https://clerk.com e um novo aplicativo
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Rotas de redirecionamento após login/logout (padrão já configurado)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# -----------------------------------------------------------------------------
# CRON / AGENDAMENTOS — OBRIGATÓRIO se usar alertas automáticos
# Gere uma chave aleatória segura: openssl rand -hex 32
# Use este valor no header "x-api-key" ao chamar /api/cron/alerts
# -----------------------------------------------------------------------------
CRON_SECRET="sua-chave-secreta-aleatoria-longa"

# -----------------------------------------------------------------------------
# WHATSAPP (Evolution API) — OPCIONAL
# Necessário para alertas automáticos de vencimento via WhatsApp
# Instale a Evolution API: https://github.com/EvolutionAPI/evolution-api
# -----------------------------------------------------------------------------
EVOLUTION_API_URL="https://sua-evolution-api.com"
EVOLUTION_API_KEY="sua-chave-da-evolution-api"
EVOLUTION_INSTANCE="nome-da-sua-instancia"

# Proxy N8N — alternativa ao acesso direto (útil em Windows)
# WHATSAPP_PROXY_URL="https://seu-n8n.com/webhook/whatsapp-proxy"

# -----------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL (Google Gemini) — OPCIONAL
# Necessário para os insights financeiros com IA
# Obtenha em: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY="sua-chave-do-gemini"

# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------
NODE_ENV="development"
